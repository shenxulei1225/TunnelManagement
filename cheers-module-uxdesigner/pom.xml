<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.cheers</groupId>
        <artifactId>tunnel-management</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cheers-module-uxdesigner</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        UX Designer 模块，提供专业的用户体验设计工具。
        包含：工作台管理、设计文件管理、项目管理、模板管理等功能。
    </description>

    <dependencies>
        <!-- 业务组件 -->
        <dependency>
            <groupId>com.cheers</groupId>
            <artifactId>cheers-framework-data-permission</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cheers</groupId>
            <artifactId>cheers-framework-tenant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cheers</groupId>
            <artifactId>cheers-framework-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cheers</groupId>
            <artifactId>cheers-framework-mybatis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cheers</groupId>
            <artifactId>cheers-framework-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cheers</groupId>
            <artifactId>cheers-framework-excel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Jakarta组件 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project> 