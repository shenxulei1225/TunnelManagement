<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.cheers</groupId>
        <artifactId>tunnel-management</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cheers-framework</artifactId>
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>框架基础</description>

    <modules>
        <module>cheers-framework-common</module>
        <module>cheers-framework-security</module>
        <module>cheers-framework-web</module>
        <module>cheers-framework-redis</module>
        <module>cheers-framework-tenant</module>
        <module>cheers-framework-job</module>
        <module>cheers-framework-mybatis</module>
        <module>cheers-framework-data-permission</module>
        <module>cheers-framework-excel</module>
        <module>cheers-framework-websocket</module>
        <module>cheers-framework-mq</module>
        <module>cheers-framework-monitor</module>
        <module>cheers-framework-ip</module>
    </modules>

    <properties>
        <revision>1.0.0-snapshot</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <!-- Spring 相关 -->
        <spring-boot.version>3.2.2</spring-boot.version>
        <!-- Web 相关 -->
        <knife4j.version>4.3.0</knife4j.version>
        <springdoc.version>2.3.0</springdoc.version>
        <swagger.version>2.2.20</swagger.version>
        <!-- DB 相关 -->
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <dynamic-datasource.version>4.2.0</dynamic-datasource.version>
        <mybatis-plus-generator.version>3.5.4.1</mybatis-plus-generator.version>
        <druid.version>1.2.20</druid.version>
        <!-- Redis 相关 -->
        <redisson.version>3.27.1</redisson.version>
        <!-- 工具类相关 -->
        <hutool.version>5.8.25</hutool.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <transmittable-thread-local.version>2.14.5</transmittable-thread-local.version>
        <commons-lang3.version>3.13.0</commons-lang3.version>
        <commons-io.version>2.15.1</commons-io.version>
        <commons-collections4.version>4.4</commons-collections4.version>
        <easyexcel.version>3.3.3</easyexcel.version>
        <guava.version>32.1.3-jre</guava.version>
        <freemarker.version>2.3.32</freemarker.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 统一依赖管理 -->
            <dependency>
                <groupId>com.cheers</groupId>
                <artifactId>cheers-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 编译插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project> 